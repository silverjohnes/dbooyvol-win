<Application x:Class="DBooyvol.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DBooyvol.App">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVisInverse" Invert="True" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="ComboBox" x:Key="FieldCombo">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Application.Resources>
</Application>
