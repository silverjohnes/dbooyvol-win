<Application x:Class="DBooyvol.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DBooyvol.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeService inserts Light.xaml or Dark.xaml at index 0. -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:NullToVisibilityConverter x:Key="NullToVisInverse" Invert="True" />
            <local:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
