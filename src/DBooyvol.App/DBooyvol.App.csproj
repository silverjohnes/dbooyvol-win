<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DBooyvol.App</RootNamespace>
    <AssemblyName>DBooyvol</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DBooyvol.Core/DBooyvol.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../resources/locales/**/*" LinkBase="locales" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../drivers/*.jar" LinkBase="drivers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../sidecar/build/sidecar.jar" Link="sidecar.jar" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../sidecar/build/sidecar.jar')" />
    <None Include="../../drivers/sidecar.jar" Link="sidecar.jar" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('../../sidecar/build/sidecar.jar')" />
  </ItemGroup>
</Project>
