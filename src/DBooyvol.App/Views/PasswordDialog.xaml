<Window x:Class="DBooyvol.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пароль" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <PasswordBox x:Name="PasswordInput" Padding="4,3" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Отмена" Width="88" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
