<Window x:Class="DBooyvol.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История запросов" Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="FilterBox" Padding="4,3" TextChanged="Filter_Changed"
                     ToolTip="Поиск по SQL или подключению" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Очистить историю" Width="140" Click="Clear_Click" Margin="0,0,8,0" />
            <Button Content="Вставить" Width="100" IsDefault="True" Click="Insert_Click" Margin="0,0,8,0" />
            <Button Content="Закрыть" Width="90" IsCancel="True" />
        </StackPanel>

        <ListView x:Name="List" SelectionMode="Single" MouseDoubleClick="Insert_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Когда" Width="140" DisplayMemberBinding="{Binding DateText}" />
                    <GridViewColumn Header="Подключение" Width="150" DisplayMemberBinding="{Binding Profile}" />
                    <GridViewColumn Header="SQL" Width="420" DisplayMemberBinding="{Binding SqlPreview}" />
                    <GridViewColumn Header="Строк" Width="60" DisplayMemberBinding="{Binding Rows}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
