<Window x:Class="DBooyvol.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Горячие клавиши" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Сочетания совпадают с DBeaver для Windows. Раскладка не влияет: клавиши читаются по виртуальному коду."
                       TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8" />
            <TextBox x:Name="FilterBox" Padding="4,3" TextChanged="Filter_Changed"
                     ToolTip="Фильтр по действию или сочетанию" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <TextBlock x:Name="CaptureText" VerticalAlignment="Center" Foreground="#B25000"
                       Margin="0,0,16,0" />
            <Button Content="Изменить" Width="100" Click="Change_Click" Margin="0,0,8,0" />
            <Button Content="Сбросить" Width="100" Click="Reset_Click" Margin="0,0,8,0" />
            <Button Content="Сбросить всё" Width="110" Click="ResetAll_Click" Margin="0,0,8,0" />
            <Button Content="Закрыть" Width="90" IsCancel="True" />
        </StackPanel>

        <ListView x:Name="List" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Действие" Width="330" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Сочетание" Width="170" DisplayMemberBinding="{Binding Gesture}" />
                    <GridViewColumn Header="Область" Width="100" DisplayMemberBinding="{Binding Scope}" />
                    <GridViewColumn Header="" Width="90" DisplayMemberBinding="{Binding Note}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
