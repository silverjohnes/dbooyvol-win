<!--
    Light palette. Every key here must also exist in Dark.xaml: the theme is
    swapped as a whole dictionary, and Controls.xaml only uses DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.MenuPopup" Color="#FFFFFFFF" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Line" Color="#FFE2E2E6" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#FFCFCFD4" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6E6E73" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FFAEAEB2" />

    <!-- Accent and states -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF3395FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF0071E3" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#290A84FF" />
    <SolidColorBrush x:Key="Brush.AccentSofter" Color="#140A84FF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#2E0A84FF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFD70015" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1FD70015" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFC93400" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1FFF9500" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF28CD41" />

    <!-- Grid -->
    <SolidColorBrush x:Key="Brush.GridAlt" Color="#FFF7F7F9" />
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="Brush.GridHeaderHover" Color="#FFEFEFF2" />

    <!-- Tabs and chrome -->
    <SolidColorBrush x:Key="Brush.TabActive" Color="#290A84FF" />
    <SolidColorBrush x:Key="Brush.TabHover" Color="#140A84FF" />
    <SolidColorBrush x:Key="Brush.CaptionHover" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFE81123" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#40000000" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#33000000" />

    <!-- Editor -->
    <SolidColorBrush x:Key="Brush.EditorText" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="Brush.EditorKeyword" Color="#FFE01E5A" />
    <SolidColorBrush x:Key="Brush.EditorString" Color="#FF1A7F37" />
    <SolidColorBrush x:Key="Brush.EditorNumber" Color="#FFB25000" />
    <SolidColorBrush x:Key="Brush.EditorFunction" Color="#FF0A5FCC" />
    <SolidColorBrush x:Key="Brush.EditorComment" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="Brush.EditorSelection" Color="#330A84FF" />
    <SolidColorBrush x:Key="Brush.EditorCurrentLine" Color="#08000000" />

    <!-- Typography -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.FontUi">12</sys:Double>
    <sys:Double x:Key="Size.FontSmall">11</sys:Double>
    <sys:Double x:Key="Size.FontCaption">10</sys:Double>

    <!-- Metrics -->
    <sys:Double x:Key="Size.RowHeight">22</sys:Double>
    <sys:Double x:Key="Size.TabHeight">28</sys:Double>
    <sys:Double x:Key="Size.ToolbarHeight">36</sys:Double>
    <sys:Double x:Key="Size.StatusHeight">26</sys:Double>
    <sys:Double x:Key="Size.Radius">6</sys:Double>
    <sys:Double x:Key="Size.RadiusSmall">4</sys:Double>
    <Thickness x:Key="Pad.Input">8,4</Thickness>
    <Thickness x:Key="Pad.Button">10,4</Thickness>
</ResourceDictionary>
