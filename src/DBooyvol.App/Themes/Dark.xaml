<!--
    Dark palette. Same keys as Light.xaml; see the note there.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#FF252527" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF232325" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FF2A2A2C" />
    <SolidColorBrush x:Key="Brush.MenuPopup" Color="#FF2C2C2E" />

    <!-- Lines -->
    <SolidColorBrush x:Key="Brush.Line" Color="#FF3A3A3C" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#FF48484A" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF98989D" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FF636366" />

    <!-- Accent and states -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF3D9BFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF0071E3" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#290A84FF" />
    <SolidColorBrush x:Key="Brush.AccentSofter" Color="#1A0A84FF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#3D0A84FF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF453A" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#26FF453A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1FFF9F0A" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF30D158" />

    <!-- Grid -->
    <SolidColorBrush x:Key="Brush.GridAlt" Color="#FF242426" />
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#FF2A2A2C" />
    <SolidColorBrush x:Key="Brush.GridHeaderHover" Color="#FF333336" />

    <!-- Tabs and chrome -->
    <SolidColorBrush x:Key="Brush.TabActive" Color="#330A84FF" />
    <SolidColorBrush x:Key="Brush.TabHover" Color="#1A0A84FF" />
    <SolidColorBrush x:Key="Brush.CaptionHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.CaptionCloseHover" Color="#FFE81123" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000" />

    <!-- Editor -->
    <SolidColorBrush x:Key="Brush.EditorText" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Brush.EditorKeyword" Color="#FFFF6482" />
    <SolidColorBrush x:Key="Brush.EditorString" Color="#FF3DDC84" />
    <SolidColorBrush x:Key="Brush.EditorNumber" Color="#FFFFB340" />
    <SolidColorBrush x:Key="Brush.EditorFunction" Color="#FF64A8FF" />
    <SolidColorBrush x:Key="Brush.EditorComment" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="Brush.EditorSelection" Color="#400A84FF" />
    <SolidColorBrush x:Key="Brush.EditorCurrentLine" Color="#10FFFFFF" />

    <!-- Typography -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.FontUi">12</sys:Double>
    <sys:Double x:Key="Size.FontSmall">11</sys:Double>
    <sys:Double x:Key="Size.FontCaption">10</sys:Double>

    <!-- Metrics -->
    <sys:Double x:Key="Size.RowHeight">22</sys:Double>
    <sys:Double x:Key="Size.TabHeight">28</sys:Double>
    <sys:Double x:Key="Size.ToolbarHeight">36</sys:Double>
    <sys:Double x:Key="Size.StatusHeight">26</sys:Double>
    <sys:Double x:Key="Size.Radius">6</sys:Double>
    <sys:Double x:Key="Size.RadiusSmall">4</sys:Double>
    <Thickness x:Key="Pad.Input">8,4</Thickness>
    <Thickness x:Key="Pad.Button">10,4</Thickness>
</ResourceDictionary>
